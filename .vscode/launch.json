{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/src/ta_inspector/debug.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Launch tests",
            "type": "debugpy",
            "request": "launch",
            "program": "pytest",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
